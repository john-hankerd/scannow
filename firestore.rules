rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user can look up a profile (needed to find who owns a
    // scanned QR code before a connection exists, and to show contact
    // names). Only the owner can ever write their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /connections/{connectionId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;

      // Starting a connection: you must be one of the two people, the
      // request starts 'pending', and you must be the one requesting it
      // (can't create a request "from" someone else).
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid;

      // Accepting: only the other person (not the requester) can flip
      // status to 'accepted'.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.uids
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.status == 'accepted';

      // Declining a request or removing a connection: either party, anytime.
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/connections/$(connectionId)).data.uids
          && get(/databases/$(database)/documents/connections/$(connectionId)).data.status == 'accepted';

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/connections/$(connectionId)).data.uids
          && get(/databases/$(database)/documents/connections/$(connectionId)).data.status == 'accepted'
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Reports go in write-only from the client's perspective — only
    // visible in the Firebase console, not readable by any app user.
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reportedBy == request.auth.uid;
    }
  }
}
